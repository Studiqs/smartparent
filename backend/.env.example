# ==============================================================================
# STUDIQS® SmartParent™ (v6.3 Complete) - Environment Variables Configuration
# ==============================================================================

# Application Runtime
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
PROJECT_NAME="Studiqs SmartParent Backend"
API_V1_STR=/api/v1

# Security & Authentication (Generate using: openssl rand -hex 32)
SECRET_KEY=dev_secret_key_change_in_production_min_32_characters_studiqs_v6_2
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# PostgreSQL 16 Database URLs
# Primary Async Application Connection Pool
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smartparent_db

# Synchronous Connection for Alembic Migrations
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/smartparent_db

# Dedicated Read-Only Connection for Pro Voice Engine ("Ask Studiqs")
DB_READONLY_URL=postgresql+asyncpg://studiqs_voice_readonly:voice_secret@localhost:5432/smartparent_db

# Redis Cache & Session Store
REDIS_URL=redis://localhost:6379/0

# Cross-Origin Resource Sharing (CORS) - Comma-separated URLs
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Storage & File Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Commercial Marketplace Settings
PLATFORM_COMMISSION_PERCENT=20.0
EXPERT_NET_PAYOUT_PERCENT=80.0
ESCROW_DISPUTE_WINDOW_HOURS=48

# Pro Voice Assistant Configuration
VOICE_MAX_TURNAROUND_MS=350
VOICE_READONLY_ROLE=studiqs_voice_readonly

# ==============================================================================
# v6.3 Extension Settings (Section 24-27)
# ==============================================================================

# Razorpay Payment Gateway (Section 24)
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxx

# GST Taxation (Section 24)
GST_RATE_PERCENT=18.0
COMPANY_GST_NUMBER=

# Video Tutorial Storage (Section 26)
VIDEO_STORAGE_BUCKET=studiqs-smartparent-videos
VIDEO_SIGNED_URL_EXPIRY_SECONDS=900

# Support Centre SLA (Section 27)
SUPPORT_SLA_HOURS=48
